# WhatsApp session auth file (auto-generated)
# WA_SESSION_FILE=auth_info.json
# Clear saved WhatsApp login on backend restart so a fresh QR appears.
FORCE_NEW_QR_ON_START=true

# AI API Configuration (OpenRouter)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-real-openrouter-key-here
AI_MODEL=google/gemini-2.5-flash

# Server port for health check
PORT=3001
